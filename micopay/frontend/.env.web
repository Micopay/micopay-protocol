# Testnet APK build — overrides .env base values
VITE_API_URL=https://api.micopay.app
# CETES/Blend trading UI (see docs/AUDIT_MOBILE_MAINNET.md finding B2 — that
# code path doesn't move real user funds yet). Enabled here because testnet
# builds are internal/demo builds; keep this UNSET in .env.mainnet/.env.production.
VITE_ENABLE_DEFI_TRADING=true
# Retirar a banco (SPEI via Etherfuse v2). Encendido en testnet para
# probarlo en el APK antes de pasar a Play (ver
# docs/PLAN_RETIRO_BANCO_2026-10-20.md).
VITE_ENABLE_BANK_WITHDRAW=true
VITE_STELLAR_NETWORK=TESTNET
VITE_ESCROW_CONTRACT_ID=CALS46FVLSLLPASFHAZVRCSQCUFUSKW64547L6OUDLLPEORKNCXDUDH3
# USDC del escrow de testnet: emisor propio de pruebas (contracts/TESTNET.md),
# no el de Circle, para poder emitirlo a las billeteras de demo.
VITE_USDC_ISSUER=GADK7SUS7NHIGERQBKF7R67A5DNIEFWG4YKNHLTQM5JN4KP2QISMJSHG
VITE_CETES_ISSUER=GCRYUGD5NVARGXT56XEZI5CIFCQETYHAPQQTHO2O3IQZTHDH4LATMYWC
# MapReal tile style (MapTiler free-tier style URL). Pending: Eric needs to
# provide a MapTiler API key/style — until set, MapReal falls back to the
# public MapLibre demo style and shows a small "dev map" notice.
VITE_MAP_STYLE_URL=

# Explicito y no heredado de .env: el activo del escrow es el dato del que
# depende que se cree la trustline correcta, y heredarlo en silencio fue como
# se colo el USDC.
VITE_ESCROW_ASSET_CODE=USDC
VITE_ESCROW_ASSETS=USDC,XLM
# APK como billetera: contratos que acepta desde la web. Sin esta lista o sin
# VITE_WALLETCONNECT_PROJECT_ID, las conexiones web quedan apagadas.
VITE_ESCROW_ALLOWED_CONTRACTS=CALS46FVLSLLPASFHAZVRCSQCUFUSKW64547L6OUDLLPEORKNCXDUDH3,CCX5E4ALJ5J5ZUOW7ZKXYDJ23ZREKDWYR6JR62NBOSTHUQ3LIGKG6GU4
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SEP10_SIGNING_KEY=GDI4RVFVG3O2UVGJDVXIZG3Q2KW5E64LILFMMYENWA25BXLVBK5634RN
# Solo la web: firma la billetera del usuario.
VITE_SIGNER_MODE=external
